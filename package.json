{
  "name": "c2go-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && tsx scripts/check-seo.ts && pagefind --site dist && tsx scripts/check-links.ts",
    "preview": "astro preview",
    "check": "astro check && tsx scripts/validate-content.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm check && pnpm build && playwright test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
